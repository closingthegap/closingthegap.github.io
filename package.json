{
	"name": "ctg-redux",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"archive": "node scripts/archive_data.ts",
		"build": "vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"deploy": "npm run archive && npm run git-sync && npm run build && gh-pages -td build",
		"deploy-simple": "npm run build && gh-pages -td build",
		"dev": "vite dev",
		"format": "prettier --write .",
		"git-sync": "git add src/data && (git commit -m 'Update archived data' || echo 'No changes to commit') && git push",
		"lint": "prettier --check . && eslint .",
		"preview": "vite preview",
		"test": "node --test scripts/*_test.ts",
		"test:browser": "playwright test"
	},
	"dependencies": {
		"@emailjs/browser": "^5.0.3",
		"leaflet": "^1.9.4",
		"vega-embed": "^7.3.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.4",
		"@types/leaflet": "^1.9.22",
		"@types/node": "^24.0.0",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"gh-pages": "^6.3.0",
		"globals": "^17.0.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.4",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5"
	},
	"engines": {
		"node": ">=24"
	}
}
